<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="OverOS Light">
    <item label="Terminal">
      <action name="Execute"><command>lxterminal</command></action>
    </item>
    <item label="Navegador leve (NetSurf)">
      <action name="Execute"><command>netsurf-gtk</command></action>
    </item>
    <item label="Firefox (pesado, pode travar)">
      <action name="Execute"><command>firefox-esr</command></action>
    </item>
    <item label="Videos (mpv)">
      <action name="Execute"><command>mpv --player-operation-mode=pseudo-gui</command></action>
    </item>
    <item label="Arquivos">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <separator/>
    <item label="Testes do notebook">
      <action name="Execute"><command>lxterminal -e overos-testes</command></action>
    </item>
    <item label="Conectar ao Wi-Fi (nmtui)">
      <action name="Execute"><command>lxterminal -e nmtui</command></action>
    </item>
    <item label="Monitor de recursos (btop)">
      <action name="Execute"><command>lxterminal -e btop</command></action>
    </item>
    <separator/>
    <item label="Reiniciar">
      <action name="Execute"><command>sudo systemctl reboot</command></action>
    </item>
    <item label="Desligar">
      <action name="Execute"><command>sudo systemctl poweroff</command></action>
    </item>
  </menu>
</openbox_menu>
