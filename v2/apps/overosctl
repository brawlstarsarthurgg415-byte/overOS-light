#!/bin/sh
# OverOS Apps — utilitários nativos leves para o ambiente mínimo.
set -eu
CONFIG_DIR="${XDG_CONFIG_HOME:-/root/.config}/overos"
CONFIG_FILE="$CONFIG_DIR/settings.conf"
ensure_config() {
  mkdir -p "$CONFIG_DIR"
  if [ ! -f "$CONFIG_FILE" ]; then
    cat > "$CONFIG_FILE" <<'CFG'
theme=dark
accent=blue
animations=off
transparency=off
panel_position=bottom
CFG
    chmod 600 "$CONFIG_FILE"
  fi
}
show_status() {
  echo "=== OverOS • Monitor do sistema ==="
  if [ -r /proc/uptime ]; then awk '{printf "Tempo ligado: %.0f segundos\n",$1}' /proc/uptime; fi
  if [ -r /proc/meminfo ]; then awk '/MemTotal:/{t=$2}/MemAvailable:/{a=$2}END{if(t>0)printf "Memória: %.0f MiB total • %.0f MiB disponível\n",t/1024,a/1024}' /proc/meminfo; fi
  echo "Armazenamento:"
  df -h 2>/dev/null || df
  echo "Kernel: $(uname -r)"
  echo "Arquitetura: $(uname -m)"
}
show_settings() {
  ensure_config
  echo "=== Configurações OverOS ==="
  cat "$CONFIG_FILE"
  echo "Editar: overosctl settings set CHAVE VALOR"
}
set_setting() {
  ensure_config
  key="${1:-}"; value="${2:-}"
  case "$key" in
    theme) case "$value" in dark|light|system) ;; *) echo "theme: dark, light ou system" >&2; exit 2;; esac ;;
    accent) case "$value" in blue|violet|teal|rose|amber) ;; *) echo "accent: blue, violet, teal, rose ou amber" >&2; exit 2;; esac ;;
    animations|transparency) case "$value" in on|off|auto) ;; *) echo "$key: on, off ou auto" >&2; exit 2;; esac ;;
    panel_position) case "$value" in bottom|top|left|right) ;; *) echo "panel_position: bottom, top, left ou right" >&2; exit 2;; esac ;;
    *) echo "Configuração desconhecida: $key" >&2; exit 2 ;;
  esac
  tmp="$CONFIG_FILE.tmp"
  if grep -q "^$key=" "$CONFIG_FILE"; then sed "s|^$key=.*|$key=$value|" "$CONFIG_FILE" > "$tmp"
  else cat "$CONFIG_FILE" > "$tmp"; printf '%s=%s\n' "$key" "$value" >> "$tmp"; fi
  chmod 600 "$tmp"; mv "$tmp" "$CONFIG_FILE"
  echo "Salvo: $key=$value"
}
open_files() {
  target="${1:-/root}"
  [ -d "$target" ] || { echo "Pasta não encontrada: $target" >&2; exit 1; }
  echo "=== Arquivos: $target ==="; ls -lah "$target"
  echo "Navegar: cd \"$target\" | Copiar: cp ORIGEM DESTINO | Mover: mv ORIGEM DESTINO"
}
show_help() {
  echo "OverOS Apps — uso:"
  echo "  overosctl                 Menu"
  echo "  overosctl status          Monitor do sistema"
  echo "  overosctl files [PASTA]   Arquivos"
  echo "  overosctl settings        Configurações"
  echo "  overosctl settings set CHAVE VALOR"
  echo "  overosctl help            Ajuda"
}
case "${1:-menu}" in
  status|monitor) show_status ;;
  files|arquivos) shift; open_files "${1:-/root}" ;;
  settings|config) shift; if [ "${1:-}" = set ]; then shift; set_setting "${1:-}" "${2:-}"; else show_settings; fi ;;
  help|-h|--help) show_help ;;
  menu)
    echo "╭──────────────────────────────╮"
    echo "│       OVEROS • APLICATIVOS   │"
    echo "╰──────────────────────────────╯"
    echo "1) Monitor do sistema"; echo "2) Arquivos"; echo "3) Configurações"; echo "4) Terminal"
    printf "Escolha: "; read choice
    case "$choice" in 1) show_status;; 2) open_files /root;; 3) show_settings;; 4) exec /bin/sh;; *) echo "Opção inválida"; exit 2;; esac
    ;;
  *) show_help; exit 2 ;;
esac
